{
  "manifest_version": 3,
  "name": "QA pro — загрузчик в Сферу ФТ",
  "version": "1.8.0",
  "description": "Загружает тест-кейсы из QA pro в Сферу ФТ от вашего имени — и из браузера, и из приложения Claude для компьютера. Даёт QA pro в браузере доступ к контексту: папке или git-репозиторию через мост, GitHub по токену.",
  "permissions": [
    "storage",
    "cookies",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://sfera-t1.ru/*",
    "https://api.github.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://*.claudeusercontent.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Загрузка тест-кейсов в Сферу ФТ"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://*.claudeusercontent.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}
